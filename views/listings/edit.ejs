<% layout('/layouts/boilerplate') -%>

    <body>
        <div class="row offset-2">
            <div class="col-8">
                <form method="POST" action="/listings/<%= listingData._id %>?_method=PUT">
                    <br /><br />
                    <h3><b>Edit this listing</b></h3>
                    <br />
                    <div>
                        <label for="title" class="form-label">Title: </label>
                        <input name="listing[title]" value="<%= listingData.title %>" type="text"
                            placeholder="write title" class="form-control" /><br><br>
                    </div>

                    <div>
                        <label for="description" class="form-label">Description: </label>
                        <textarea name="listing[description]" type="text" value="<%= listingData.description %>"
                            class="form-control"><%= listingData.description %></textarea><br><br>
                    </div>

                    <div>
                        <label for="image" class="form-label">Image URL: </label>
                        <input name="listing[image]" type="text" value="<%= listingData.image.url %>"
                            class="form-control" /><br><br>
                    </div>

                   <div class="row">
                     <div class="col-md-4">
                        <label for="price" class="form-label">Price: </label>
                        <input name="listing[price]" type="number" value="<%= listingData.price %>"
                            class="form-control" /><br><br>
                    </div>

                    <div class="col-md-8">
                        <label for="location" class="form-label">Location: </label>
                        <input name="listing[location]" type="text" value="<%= listingData.location %>"
                            class="form-control" /><br><br>
                    </div>
                   </div>

                    <div>
                        <label for="price" class="form-label">Country: </label>
                        <input name="listing[country]" type="text" value="<%= listingData.country %>"
                            class="form-control" /><br><br>
                    </div>

                    <button type="submit" class="btn btn-outline theme-success">edit</button>
                    <br /><br />

                </form>
            </div>
        </div>
    </body>