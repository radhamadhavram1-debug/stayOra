<% layout('/layouts/boilerplate') -%>

<body>
    <br/><br />
    <div class="card row offset-2" style="width: 60%;">
        
        <img src="<%= listingData.image.url %>" class="card-img-top" alt="An img is here">
        <div class="card-body">
           
                <b>
                    Listing Details
                </b>
          

            <h2 class="card-text">
                <%= listingData.title %>
            </h2>
        </div>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                <%= listingData.description %>
            </li>
            <li class="list-group-item" <%=listingData.price.toLocaleString("en-IN") %></li>
            <li class="list-group-item">
                <%= listingData.location %>
            </li>
            <li class="list-group-item">
                <%= listingData.country %>
            </li>
        </ul>
        <div class="card-body flex-row gap-4">
            <button class="btn btn-outline theme-success"><a href="/listings/<%= listingData._id %>/edit">edit
                    this</a></button>
            <form method="POST" action="/listings/<%= listingData._id %>?_method=DELETE">
                <button class="btn btn-outline theme-success" type="submit">Delete </button>
            </form>
        </div>
    </div>
    <br/><br />
</body>