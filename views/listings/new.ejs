<% layout('/layouts/boilerplate') -%>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <br /><br />
                <h3><b>Create a new listing</b></h3>
                <br />
                <form method="POST" action="/listings">

                    <div>
                        <label for="title" class="form-label">Title</label>
                        <input name="listing[title]" type="text" placeholder="write title"
                            class="form-control" /><br><br>
                    </div>

                    <div>
                        <label for="description" class="form-label">Desc: </label>
                        <textarea name="listing[description]" type="text" placeholder="write description"
                            class="form-control"></textarea><br><br>
                    </div>

                    <div>
                        <label for="image" class="form-label">Image URL: </label>
                        <input name="listing[image]" type="text" placeholder="enter img url"
                            class="form-control" /><br><br>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <label for="price" class="form-label">Price: </label>
                            <input name="listing[price]" type="number" placeholder="write price"
                                class="form-control" /><br><br>
                        </div>

                        <div class="col-md-8">
                            <label for="location" class="form-label" ">Location: </label>
               <input name=" listing[location]" type="text" placeholder="write location"
                                class="form-control" /><br><br>
                        </div>

                    </div>

                    <div>
                        <label for="country" class="form-label" ">Country: </label>
                       <input name=" listing[country]" type="text" placeholder="write country name" class="form-control" /><br><br>

                    </div>


                    <button class="btn btn-outline theme-success">Add</button>
            </div>
        </div>
        <br /><br />
        </form>
    </body>